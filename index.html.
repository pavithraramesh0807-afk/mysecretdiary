<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#ffe3ef">
<title>My Secret Diary ❤️</title>
<style>
:root{--pink:#ef8fb7;--deep:#a94f78;--pale:#fff4f8;--ink:#56394a}
*{box-sizing:border-box}body{margin:0;min-height:100vh;font-family:Georgia,serif;color:var(--ink);background:radial-gradient(circle at 10% 10%,#fff 0 7%,transparent 8%),linear-gradient(135deg,#fff5f9,#ffe0ed 55%,#f9e6ff)}
.wrap{width:min(920px,92%);margin:34px auto}.brand{text-align:center;margin-bottom:22px}.brand .heart{font-size:35px}.brand h1{font-size:clamp(29px,5vw,44px);margin:5px 0;color:#b65d87}.brand p{margin:0;color:#93677c}
.panel{background:#ffffffdf;border:1px solid #f4c8da;border-radius:24px;padding:clamp(20px,4vw,34px);box-shadow:0 16px 45px #b96b8c22;backdrop-filter:blur(8px)}
.center{text-align:center;max-width:470px;margin:auto}.lock{font-size:45px}.sub{color:#98788a;line-height:1.5}label{display:block;text-align:left;font-size:14px;margin:15px 0 7px}
input,textarea{width:100%;border:1px solid #e9b9ce;border-radius:13px;padding:13px 14px;background:#fffafd;color:var(--ink);font:16px Georgia,serif;outline:none}input:focus,textarea:focus{border-color:var(--pink);box-shadow:0 0 0 3px #ef8fb722}
button{border:0;border-radius:999px;padding:12px 19px;background:var(--pink);color:white;font-weight:bold;font-size:15px;cursor:pointer;margin-top:14px}button:hover{filter:brightness(.97)}button.secondary{background:#f8e3ed;color:#92516f}button.danger{background:#f8e3ed;color:#a33d62}.full{width:100%}.msg{min-height:22px;color:#a13e69;font-size:14px;margin-top:9px}
.hidden{display:none!important}.top{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.top h2{margin:0;color:#b65d87}.compose{margin:20px 0;padding:18px;border-radius:18px;background:#fff6fa;border:1px dashed #e9b9ce}textarea{min-height:125px;resize:vertical;line-height:1.5}.entry{background:#fff9fc;border:1px solid #f1d1df;border-radius:16px;padding:16px;margin:12px 0;white-space:pre-wrap;overflow-wrap:anywhere}.entry time{display:block;font-size:12px;color:#a47b90;margin-bottom:9px}.entry p{margin:0;line-height:1.55}.entry button{margin-top:10px;padding:8px 13px;font-size:13px}.empty{text-align:center;color:#a47b90;padding:24px}.note{font:13px Arial,sans-serif;color:#997b8b;line-height:1.5;text-align:center;margin:18px auto 0;max-width:700px}
@media(max-width:520px){.wrap{margin:18px auto}.top{align-items:flex-start}.top button{margin-top:0}}
</style>
</head>
<body>
<main class="wrap">
  <header class="brand"><div class="heart">🎀 ❤️ 🔒</div><h1>My Secret Diary ❤️</h1><p>A little place for your thoughts, dreams and memories.</p></header>
  <section id="gate" class="panel">
    <div class="center">
      <div class="lock">🔐</div>
      <h2 id="gateTitle">Create your private diary</h2>
      <p class="sub" id="gateText">Choose a PIN with at least 8 digits. You will need it whenever you open this diary on this browser.</p>
      <label for="pin">Your private PIN</label><input id="pin" type="password" inputmode="numeric" autocomplete="off" maxlength="32" placeholder="Enter at least 8 digits">
      <button id="gateBtn" class="full">Create my diary 💗</button>
      <div id="gateMsg" class="msg" role="status"></div>
    </div>
  </section>
  <section id="diary" class="panel hidden">
    <div class="top"><div><h2>Dear Diary… 💌</h2><div class="sub">Your thoughts stay yours.</div></div><button id="lockBtn" class="secondary">🔒 Lock diary</button></div>
    <div class="compose">
      <label for="entryText">Write your heart out</label>
      <textarea id="entryText" placeholder="What happened today? What made you smile? Write anything…"></textarea>
      <button id="saveBtn">Save entry ✨</button><span id="saveMsg" class="msg" aria-live="polite"></span>
    </div>
    <h3>My memories 🌷</h3><div id="entries"></div>
  </section>
  <p class="note">Privacy note: entries are encrypted in this browser using your PIN. This starter version does not sync between devices. If you clear this browser's site data or forget your PIN, your diary may be lost. Do not use a short PIN or a PIN you use elsewhere.</p>
</main>
<script>
const STORE = "my-secret-diary-encrypted-v1";
const ITERATIONS = 600000;
const enc = new TextEncoder(), dec = new TextDecoder();
let diaryEntries = [], cryptoKey = null;

const $ = id => document.getElementById(id);
const b64 = bytes => btoa(String.fromCharCode(...new Uint8Array(bytes)));
const unb64 = value => Uint8Array.from(atob(value), c => c.charCodeAt(0));

async function deriveKey(pin, salt) {
  const material = await crypto.subtle.importKey("raw", enc.encode(pin), "PBKDF2", false, ["deriveKey"]);
  return crypto.subtle.deriveKey({name:"PBKDF2", salt, iterations:ITERATIONS, hash:"SHA-256"}, material,
    {name:"AES-GCM", length:256}, false, ["encrypt","decrypt"]);
}
async function encryptAndStore() {
  const salt = window._diarySalt;
  const iv = crypto.getRandomValues(new Uint8Array(12));
  const data = enc.encode(JSON.stringify(diaryEntries));
  const ciphertext = await crypto.subtle.encrypt({name:"AES-GCM", iv}, cryptoKey, data);
  localStorage.setItem(STORE, JSON.stringify({salt:b64(salt), iv:b64(iv), data:b64(ciphertext)}));
}
function showDiary() { $("gate").classList.add("hidden"); $("diary").classList.remove("hidden"); renderEntries(); }
function showGate() { $("diary").classList.add("hidden"); $("gate").classList.remove("hidden"); $("pin").value=""; $("gateMsg").textContent=""; }
function renderEntries() {
  const host=$("entries"); host.replaceChildren();
  if(!diaryEntries.length){const p=document.createElement("div");p.className="empty";p.textContent="No entries yet. Your first memory is waiting here. 💗";host.append(p);return;}
  [...diaryEntries].reverse().forEach(item=>{
    const card=document.createElement("article");card.className="entry";
    const time=document.createElement("time");time.textContent=new Date(item.date).toLocaleString();
    const p=document.createElement("p");p.textContent=item.text;
    const del=document.createElement("button");del.className="danger";del.textContent="Delete entry";del.addEventListener("click",async()=>{
      if(!confirm("Delete this diary entry?"))return;
      diaryEntries=diaryEntries.filter(x=>x.id!==item.id);await encryptAndStore();renderEntries();
    });
    card.append(time,p,del);host.append(card);
  });
}
async function setupOrUnlock(){
  const pin=$("pin").value.trim(), saved=localStorage.getItem(STORE);
  if(!/^\d{8,32}$/.test(pin)){$("gateMsg").textContent="Please enter a PIN with 8–32 digits.";return;}
  $("gateBtn").disabled=true;$("gateMsg").textContent="Securing your diary…";
  try{
    if(!saved){
      window._diarySalt=crypto.getRandomValues(new Uint8Array(16));
      cryptoKey=await deriveKey(pin,window._diarySalt);diaryEntries=[];
      await encryptAndStore();$("gateMsg").textContent="";showDiary();
    }else{
      const record=JSON.parse(saved);window._diarySalt=unb64(record.salt);
      cryptoKey=await deriveKey(pin,window._diarySalt);
      const plain=await crypto.subtle.decrypt({name:"AES-GCM",iv:unb64(record.iv)},cryptoKey,unb64(record.data));
      diaryEntries=JSON.parse(dec.decode(plain));$("gateMsg").textContent="";showDiary();
    }
  }catch(e){cryptoKey=null;$("gateMsg").textContent="That PIN didn't unlock this diary. Please try again.";}
  finally{$("gateBtn").disabled=false;}
}
$("gateBtn").addEventListener("click",setupOrUnlock);
$("pin").addEventListener("keydown",e=>{if(e.key==="Enter")setupOrUnlock();});
$("saveBtn").addEventListener("click",async()=>{
  const text=$("entryText").value.trim();if(!text){$("saveMsg").textContent="Write something first.";return;}
  diaryEntries.push({id:crypto.randomUUID(),date:new Date().toISOString(),text});
  try{await encryptAndStore();$("entryText").value="";$("saveMsg").textContent="Saved privately. 💗";renderEntries();}
  catch(e){diaryEntries.pop();$("saveMsg").textContent="Could not save. Please try again.";}
});
$("lockBtn").addEventListener("click",()=>{cryptoKey=null;diaryEntries=[];$("entries").replaceChildren();showGate();});
if(!window.crypto?.subtle){$("gateBtn").disabled=true;$("gateMsg").textContent="This browser does not support secure encryption. Please use an updated browser on HTTPS or localhost.";}
const existing=localStorage.getItem(STORE);
if(existing){$("gateTitle").textContent="Welcome back 💗";$("gateText").textContent="Enter your PIN to unlock your diary."; $("gateBtn").textContent="Unlock my diary 🔓";}
</script>
</body>
</html>
